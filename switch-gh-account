#!/usr/bin/env bash
# switch-gh-account: Switch between GitHub accounts for gh and git
# Usage: switch-gh-account <username>

set -e

CONFIG_FILE="$HOME/.gh-accounts"

ACCOUNT="$1"

if [[ -z "$ACCOUNT" ]]; then
    echo "Usage: switch-gh-account <username>"
    echo ""
    echo "Available accounts:"
    gh auth status --hostname github.com 2>/dev/null | grep -E "^\s+[a-zA-Z]" | head -5 || true
    exit 1
fi

SSH_KEY=""
if [[ -f "$CONFIG_FILE" ]]; then
    SSH_KEY=$(grep "^${ACCOUNT}_ssh_key=" "$CONFIG_FILE" 2>/dev/null | cut -d= -f2-)
fi

if [[ -z "$SSH_KEY" ]]; then
    HOSTNAME=$(hostname)
    HOSTNAME="${HOSTNAME%.local}"
    SSH_KEY="$HOME/.ssh/id_github_${HOSTNAME}_${ACCOUNT}"
fi

echo "Switching to account: $ACCOUNT"

gh auth switch --user "$ACCOUNT" --hostname github.com

USER_ID=$(gh api user --jq '.id')
USER_LOGIN=$(gh api user --jq '.login')
EMAIL="${USER_ID}+${USER_LOGIN}@users.noreply.github.com"

echo "No-reply email: $EMAIL"

if git rev-parse --git-dir > /dev/null 2>&1; then
    git config user.name "$ACCOUNT"
    git config user.email "$EMAIL"
    echo "Git user.name and user.email set for this repository"
else
    echo "Not in a git repository - skipping user.name/user.email"
fi

GIT_PROTOCOL=$(gh config get git_protocol --host github.com 2>/dev/null || echo "https")
echo "gh git_protocol: $GIT_PROTOCOL"

if git rev-parse --git-dir > /dev/null 2>&1; then
    REMOTE_URL=$(git remote get-url origin 2>/dev/null || git remote get-url $(git remote | head -1) 2>/dev/null || echo "")

    if [[ -n "$REMOTE_URL" ]]; then
        if [[ "$GIT_PROTOCOL" == "ssh" ]]; then
            if [[ "$REMOTE_URL" =~ ^https://github\.com/([^/]+)/(.+)$ ]]; then
                NEW_URL="git@github.com:${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"
                git remote set-url origin "$NEW_URL"
                echo "Remote URL converted to SSH: $NEW_URL"
            fi
        else
            if [[ "$REMOTE_URL" =~ ^git@github\.com:(.+)$ ]]; then
                NEW_URL="https://github.com/${BASH_REMATCH[1]}"
                git remote set-url origin "$NEW_URL"
                echo "Remote URL converted to HTTPS: $NEW_URL"
            fi
        fi
    fi

    REMOTE_URL=$(git remote get-url origin 2>/dev/null || echo "")

    if [[ "$REMOTE_URL" =~ ^git@|^ssh:// ]]; then
        if [[ -f "$SSH_KEY" ]]; then
            git config core.sshCommand "ssh -i '$SSH_KEY' -o IdentitiesOnly=yes"
            echo "SSH key: $SSH_KEY (set for current repo)"
        else
            echo "SSH key not found (tried: $SSH_KEY)"
        fi
    elif [[ "$REMOTE_URL" =~ ^https:// ]]; then
        git config --unset core.sshCommand 2>/dev/null || true
        echo "Remote: HTTPS (using gh credential helper)"
    fi
else
    echo "Not in a git repository - skipping remote URL sync"
fi

echo ""
echo "Active gh account:"
gh auth status --hostname github.com --active