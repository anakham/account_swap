#!/usr/bin/env bash
# setup-git-includes: Configure per-directory git identity switching
# Run this to set up automatic git identity switching based on directories

set -e

GITCONFIG="$HOME/.gitconfig"
BACKUP="$GITCONFIG.backup.$(date +%Y%m%d%H%M%S)"

echo "=== Git Per-Directory Identity Setup ==="
echo ""

if [[ -f "$GITCONFIG" ]]; then
    echo "Backing up existing .gitconfig to $BACKUP"
    cp "$GITCONFIG" "$BACKUP"
fi

echo "Enter directories for each account (absolute paths, will be created if missing):"
echo ""

read -p "Directory for 'anakham': " DIR_ANAKHAM
read -p "Directory for 'anakham-ai': " DIR_ANAKHAM_AI

mkdir -p "$DIR_ANAKHAM" "$DIR_ANAKHAM_AI"

echo ""
echo "Creating git config files..."

cat > "$HOME/.gitconfig-anakham" << 'EOF'
[user]
    name = anakham
    email = anakham@users.noreply.github.com
EOF

cat > "$HOME/.gitconfig-anakham-ai" << 'EOF'
[user]
    name = anakham-ai
    email = anakham-ai@users.noreply.github.com
EOF

echo "Updating $GITCONFIG..."

cat > "$GITCONFIG" << EOF
[user]
    name = anakham
    email = anakham@users.noreply.github.com

[includeIf "gitdir:$DIR_ANAKHAM/"]
    path = $HOME/.gitconfig-anakham

[includeIf "gitdir:$DIR_ANAKHAM_AI/"]
    path = $HOME/.gitconfig-anakham-ai
EOF

echo ""
echo "=== Setup Complete ==="
echo ""
echo "Git will automatically use:"
echo "  - anakham identity in: $DIR_ANAKHAM/"
echo "  - anakham-ai identity in: $DIR_ANAKHAM_AI/"
echo ""
echo "Test with: git config user.name (run inside those directories)"